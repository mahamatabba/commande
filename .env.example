# URL de connexion Neon (utiliser la variante "pooled", paramètre -pooler,
# pour un usage compatible avec les fonctions serverless Vercel).
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/dbname?sslmode=require"

# Secret Auth.js — générer avec `npx auth secret` ou `openssl rand -base64 33`
AUTH_SECRET=""
